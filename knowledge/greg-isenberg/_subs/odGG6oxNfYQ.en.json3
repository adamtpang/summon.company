  }, {
    "tStartMs": 83820,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "we could spend the whole hour talking about \nMcGill. I can't believe you dropped out."
    } ]
  }, {
    "tStartMs": 87300,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "I mean, maybe it was the right move, \nbut I had a freaking blast there."
    } ]
  }, {
